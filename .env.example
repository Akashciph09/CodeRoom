# API
PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_CODE_BYTES=65536

# Supabase (values from `pnpm exec supabase status`; these are the local defaults)
SUPABASE_URL=http://127.0.0.1:54321
# Server-only: owner connection, bypasses RLS. Never expose to the browser.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Safe for the browser (sign-in only; RLS blocks table access).
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Redis (queue + pub/sub)
REDIS_URL=redis://localhost:6379

# Worker / sandbox
WORKER_CONCURRENCY=2
SANDBOX_TIMEOUT_MS=2000
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5

# AI
AI_SUMMARY_PROVIDER=claude
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Realtime gateway
WS_MAX_PAYLOAD_BYTES=1048576
DOC_PERSIST_DEBOUNCE_MS=2000

# Reliability
SUBMIT_RATE_LIMIT_PER_MIN=10
OUTBOX_SWEEP_INTERVAL_MS=10000
OUTBOX_STALE_AFTER_MS=30000
ROOM_STATUS_RECONCILE_MS=5000
