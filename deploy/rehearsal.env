# Throwaway values for the local rehearsal only (compose.rehearsal.yml). Never use them on a server:
# a real deploy/.env comes from scripts/gen-secrets.sh.
APP_URL=http://localhost:8080
API_URL=http://localhost:8081
POSTGRES_PASSWORD=rehearsal0000000000000000000000
AUTH_JWT_SECRET=rehearsal00000000000000000000000000000000000000
# Docker Desktop on macOS shares /private/tmp with its VM; /var/lib isn't.
RUNS_DIR=/private/tmp/coderoom-rehearsal-runs
# AUTH_JWT_KEYS is generated per run: see deploy/README.md ("Rehearse locally").
