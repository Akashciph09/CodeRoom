{
  "name": "@coderoom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/smoke.ts && tsx scripts/questions-smoke.ts && tsx scripts/rooms-smoke.ts && tsx scripts/summary-smoke.ts && tsx scripts/question-generation-smoke.ts && tsx scripts/room-tests-smoke.ts",
    "smoke:question-generation": "tsx scripts/question-generation-smoke.ts",
    "smoke:summary": "tsx scripts/summary-smoke.ts && tsx scripts/question-generation-smoke.ts",
    "smoke:rooms": "tsx scripts/rooms-smoke.ts",
    "smoke:realtime": "tsx scripts/realtime-smoke.ts",
    "smoke:questions": "tsx scripts/questions-smoke.ts"
  },
  "dependencies": {
    "@coderoom/db": "workspace:^",
    "@coderoom/shared": "workspace:*",
    "bullmq": "^5.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jose": "^6.2.18",
    "lib0": "^0.2.120",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@supabase/auth-js": "^2.119.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "y-websocket": "^2.1.0"
  }
}
